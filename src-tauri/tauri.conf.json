{
  "productName": "Playly",
  "version": "2.0.5",
  "identifier": "com.playly.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Playly",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0a0c",
        "dragDropEnabled": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": "^(https://github\\.com/.*|https://t\\.me/.*|https://www\\.google\\.com/.*)$"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNTVGMzQxQTgyRDFEMUEKUldRYUhTMm9RZk5WOCsvd2tYRnNTWno3SUo5MTc4MjBGWjI2ZHZ3Vy9ETE9mR0RWOHBRL0NlSFIK",
      "endpoints": [
        "https://github.com/Aurum2347/Playly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
